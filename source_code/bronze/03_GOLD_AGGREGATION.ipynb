   "source": [
    "from pyspark.sql import functions as f\n",
    "\n",
    "df = spark.read.table('workspace.default.silver_bmtc_routes')\n",
    "\n",
    "#gold table 1\n",
    "\n",
    "route_summary = df.groupBy(\"route_id\").agg(f.count(\"route_color\").alias(\"total_colour\")\n",
    ")\n",
    "\n",
    "route_summary.write.mode(\"overwrite\").saveAsTable('route_summary')\n"
   ]
  }
